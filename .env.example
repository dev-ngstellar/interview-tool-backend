DATABASE_URL="postgresql://username:password@localhost:5432/database"
API_PORT=4000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

JWT_SECRET="your-secret-here"
JWT_EXPIRATION="24h"

STORAGE_PROVIDER="local"
STORAGE_BUCKET="recruitment-resumes"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="mock-storage-access-key"
STORAGE_SECRET_KEY="mock-storage-secret-key"
MAX_RESUME_SIZE_MB=5

EMAIL_PROVIDER="smtp"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Marketing Executive Recruitment"
